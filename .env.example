# Adresse d'écoute. Remplacez-la par l'IP du serveur sur le réseau de l'établissement.
CDI_BIND_IP=127.0.0.1
CDI_PORT=8080
# Facultatif derrière un reverse proxy HTTPS. Exemple : https://cdi.intranet.exemple.fr
CDI_ORIGIN=
# Mettre 1 seulement derrière un reverse proxy de confiance (lecture de X-Forwarded-For et X-Forwarded-Proto).
CDI_TRUST_PROXY=0
